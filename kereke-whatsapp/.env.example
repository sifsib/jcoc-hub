# ── Kapso (WhatsApp via Meta Cloud API) ──────────────────────────────────────
# Already set on Render.
KAPSO_API_KEY=
# Host only, no /platform/v1 or /meta suffix.
KAPSO_API_BASE_URL=https://api.kapso.ai
# The single central Kerekehub number every church sends through.
# Find it with: kapso whatsapp numbers list --output json
KAPSO_PHONE_NUMBER_ID=
# Only needed to create/update templates (npm run provision:templates).
KAPSO_BUSINESS_ACCOUNT_ID=
# Secret shown when you create the webhook in Kapso. Without it the webhook
# route rejects every request - opt-outs would silently stop working.
KAPSO_WEBHOOK_SECRET=
META_GRAPH_VERSION=v24.0

# ── Firebase ─────────────────────────────────────────────────────────────────
# Service account JSON, raw or base64.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Service-to-service auth ──────────────────────────────────────────────────
# Shared secret the Next.js app sends as X-Service-Key.
# RAILWAY_SERVICE_KEY is accepted as a legacy alias.
SERVICE_KEY=

# ── AI message refinement ────────────────────────────────────────────────────
# Refinement endpoints return 503 until this is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ── Tuning ───────────────────────────────────────────────────────────────────
PORT=3001
# Local numbers (082...) are expanded with this country code. 27 = South Africa.
DEFAULT_COUNTRY_CODE=27
BROADCAST_CONCURRENCY=5
BROADCAST_DELAY_MS=120
BROADCAST_MAX_RECIPIENTS=5000
