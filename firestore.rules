rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    function isSignedIn() {
      return request.auth != null;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // The caller's ACTIVE region. A user whose active region is no longer in
    // their access list (it was removed) has no region at all, so access ends
    // at once even if the server step that moves them failed (ADR-010).
    // Users without an access list are single-region users from before
    // Phase 2 and keep their one tenant.
    function userTenantId() {
      let u = userData();
      return regionHeld(u) ? u.tenantId : '__no_region__';
    }
    // Handles both a single 'role' string field and a 'roles' array field.
    function hasRole(role) {
      return (userData().roles != null && role in userData().roles)
          || (userData().role == role);
    }
    function isSuperAdmin() {
      return userData().role == 'super_admin';
    }
    function isCongregationMember() {
      return userData().role == 'congregation_member';
    }
    // True for any user who has a linked member profile - this includes
    // congregation members AND admin/team users who have linked themselves
    // to a roster record via the Profile page. Use this instead of
    // isCongregationMember() for all "member can read/write their own data" rules.
    function hasLinkedMemberProfile() {
      return userData().memberId is string && userData().memberId.size() > 0;
    }
    // Returns true if the signed-in congregation member owns the given resource
    // (their member doc has their authUid stored on it)
    function isOwnMemberDoc(resource) {
      return isCongregationMember()
          && resource.data.authUid == request.auth.uid;
    }
    function isOwner() {
      return isSuperAdmin() || hasRole('owner');
    }
    function canManageUsers() {
      return isOwner();
    }
    function canEditChurchProfile() {
      return isOwner() || hasRole('admin');
    }
    function canManageMembers() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('branch_admin');
    }
    function canReadMembers() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('member_viewer') || hasRole('viewer') || hasRole('cell_leader') || hasRole('branch_admin') || hasRole('finance') || hasRole('finance_viewer');
    }
    function canManageAttendance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader') || hasRole('branch_admin');
    }
    function canReadAttendance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('member_viewer') || hasRole('viewer') || hasRole('cell_leader') || hasRole('branch_admin');
    }
    function canManageFinance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('finance');
    }
    function canReadFinance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('finance') || hasRole('finance_viewer') || hasRole('viewer') || hasRole('branch_admin');
    }
    function canManageCommunications() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin');
    }
    // Follow-up team: the dedicated follow_up role, the manager roles that already
    // handle guests, plus ANY team member switched on in the "Follow-Up Team"
    // toggle (stored as visitorMinistry). These people may work first-time guests
    // and their follow-ups regardless of their main role.
    function canDoFollowUp() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager')
          || hasRole('follow_up') || hasRole('branch_admin')
          || userData().get('visitorMinistry', false) == true;
    }
    // ============================================
    // REGION ACCESS AND NETWORK ROLES (ADR-010) - helpers
    // ============================================
    // A user works in one region at a time (tenantId, role). Leaders with
    // several regions hold them in tenantAccess { [tenantId]: { role, roles?,
    // sectorId?, familyGroupId? } }, written only by /api/region-access.
    // network_owner and network_viewer reach every region of their orgId.
    function regionHeld(u) {
      return u.get('tenantAccess', null) == null
          || u.tenantId in u.tenantAccess
          || (u.get('networkRole', '') in ['network_owner', 'network_viewer']
              && regionInOrg(u.tenantId, u.get('orgId', '')));
    }
    function regionInOrg(tenantId, orgId) {
      return orgId is string && orgId != ''
          && tenantId is string
          && exists(/databases/$(database)/documents/tenants/$(tenantId))
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('orgId', '') == orgId;
    }
    function callerOrgId() {
      return userData().get('orgId', '');
    }
    function isNetworkOwner() {
      return userData().get('networkRole', '') == 'network_owner';
    }
    function hasNetworkRole() {
      return userData().get('networkRole', '') in ['network_owner', 'network_viewer'];
    }
    // Cross-region read and write for network roles, within their own org only.
    function networkCanRead(tenantId) {
      return hasNetworkRole() && regionInOrg(tenantId, callerOrgId());
    }
    function networkCanWrite(tenantId) {
      return isNetworkOwner() && regionInOrg(tenantId, callerOrgId());
    }
    // Sector and family group leaders: the scope held in the active region.
    function leaderSectorId() {
      return hasRole('sector_leader') ? userData().get('sectorId', '') : '';
    }
    function leaderFamilyGroupId() {
      return hasRole('family_group_leader') ? userData().get('familyGroupId', '') : '';
    }

    function sameTenant(resource) {
      return resource.data.tenantId == userTenantId();
    }
    function settingOwnTenant(newData) {
      return newData.tenantId == userTenantId();
    }
    function tenantAllowed(resource) {
      return isSuperAdmin() || sameTenant(resource);
    }
    function tenantAllowedWrite(newData) {
      return isSuperAdmin() || settingOwnTenant(newData);
    }

    // ---- Free-tier member cap ----------------------------------------------
    // Reads the tenant doc to enforce the free-tier limit. Costs one extra
    // document read per member create, which is acceptable.
    function tenantBilling(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }
    // Allows the create UNLESS the tenant is explicitly on the free tier with a
    // known count at or above a known limit. It is deliberately permissive on
    // missing data: if the tenant doc is absent, or tier / activeMemberCount /
    // memberLimit have not been set yet (a church that predates the backfill),
    // it does NOT block. That way the rule can never lock out a church whose
    // count has not been established. Run the backfill so this never happens in
    // practice, then this check is exact.
    function withinMemberLimit(newData) {
      return !exists(/databases/$(database)/documents/tenants/$(newData.tenantId))
          || tenantBilling(newData.tenantId).tier != 'free'
          || !('activeMemberCount' in tenantBilling(newData.tenantId))
          || !('memberLimit' in tenantBilling(newData.tenantId))
          || tenantBilling(newData.tenantId).activeMemberCount
               < tenantBilling(newData.tenantId).memberLimit;
    }

    // ---- Paid-plan feature gate --------------------------------------------
    // Reads the CALLER's own tenant tier to gate paid-only features (events,
    // worship, volunteers, forms, workflows, daily summary). Permissive when the
    // tier is unset (a tenant that predates the backfill) and for super admins,
    // so nothing breaks before the backfill runs. Blocks only when the tenant is
    // explicitly on the "free" tier.
    function callerIsPaid() {
      return isSuperAdmin()
          || !exists(/databases/$(database)/documents/tenants/$(userTenantId()))
          || !('tier' in tenantBilling(userTenantId()))
          || tenantBilling(userTenantId()).tier != 'free';
    }

    // ============================================
    // LOGIN AUDIT COLLECTION
    // ============================================
    // Written ONLY by the server (/api/login) using the Admin SDK, which bypasses
    // these rules. Clients may never write here, guaranteeing the trail is tamper
    // proof. Owners and admins can read their own tenant's sign-in history.
    match /login_audit/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && (isOwner() || hasRole('admin'));
      allow write: if false;
    }

    // Platform admin audit trail. Records destructive/important admin actions
    // (suspend, reactivate, delete, ticket reply, convert to beta, auto actions).
    // Written ONLY by server routes using the Admin SDK, which bypass these
    // rules. Clients may never write here, keeping the trail tamper proof. Only
    // super admins may read it.
    match /admin_audit/{id} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow write: if false;
    }

    // ============================================
    // CHURCH STRUCTURE (ADR-010) - start
    // ============================================
    // organizations > churches > region tenants > sectors > familyGroups.
    // Organisations, churches and regions are created by the server only.
    // Sectors and family groups are managed by region owners and admins and
    // by network owners. Nothing here is ever deleted: archive instead.
    // Covered by tests/rules/churchStructure.test.ts.
    match /organizations/{orgId} {
      allow read: if isSignedIn() && callerOrgId() == orgId;
      allow write: if false;
    }
    match /churches/{churchId} {
      allow read: if isSignedIn()
                  && callerOrgId() != ''
                  && resource.data.orgId == callerOrgId();
      allow write: if false;
    }

    function canManageStructureIn(tenantId) {
      return (tenantId == userTenantId() && (hasRole('owner') || hasRole('admin')))
          || networkCanWrite(tenantId);
    }
    function canReadStructureIn(tenantId) {
      return tenantId == userTenantId() || networkCanRead(tenantId);
    }
    function validStructureName(data) {
      return data.name is string && data.name.trim().size() > 0 && data.name.size() <= 100;
    }
    function sectorInTenant(sectorId, tenantId) {
      return sectorId is string
          && exists(/databases/$(database)/documents/sectors/$(sectorId))
          && get(/databases/$(database)/documents/sectors/$(sectorId)).data.tenantId == tenantId;
    }

    match /sectors/{sectorId} {
      allow read: if isSignedIn() && canReadStructureIn(resource.data.tenantId);
      allow create: if isSignedIn()
                    && canManageStructureIn(request.resource.data.tenantId)
                    && validStructureName(request.resource.data)
                    && request.resource.data.archived == false;
      allow update: if isSignedIn()
                    && canManageStructureIn(resource.data.tenantId)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && validStructureName(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'archived', 'archivedAt', 'archivedBy', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /familyGroups/{groupId} {
      allow read: if isSignedIn() && canReadStructureIn(resource.data.tenantId);
      allow create: if isSignedIn()
                    && canManageStructureIn(request.resource.data.tenantId)
                    && validStructureName(request.resource.data)
                    && request.resource.data.archived == false
                    && sectorInTenant(request.resource.data.sectorId, request.resource.data.tenantId);
      allow update: if isSignedIn()
                    && canManageStructureIn(resource.data.tenantId)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && validStructureName(request.resource.data)
                    && sectorInTenant(request.resource.data.sectorId, resource.data.tenantId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'sectorId', 'leaderMemberId', 'archived', 'archivedAt',
                                   'archivedBy', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    // The 1 January life phase review (ADR-011). Prepared and applied by the
    // server only; read by the region's owner and admins and network owners.
    match /lifePhaseReviews/{id} {
      allow read: if isSignedIn()
                  && ((resource.data.tenantId == userTenantId() && (hasRole('owner') || hasRole('admin')))
                      || networkCanWrite(resource.data.tenantId));
      allow write: if false;
    }

    // Member change history, written only by the onMemberUpdated Cloud
    // Function. Region owners and admins read their region; network owners
    // read their org.
    match /member_audit/{id} {
      allow read: if isSignedIn()
                  && ((resource.data.tenantId == userTenantId() && (hasRole('owner') || hasRole('admin')))
                      || networkCanWrite(resource.data.tenantId));
      allow write: if false;
    }
    // ============================================
    // CHURCH STRUCTURE (ADR-010) - end
    // ============================================

    // ============================================
    // TENANTS COLLECTION
    // ============================================
    // Fields only the server may write: identity, billing, plan, status, slug
    // and (from Phase 1) the organisation link. Owners and admins edit
    // everything else on the tenant doc directly from the dashboard.
    function touchesServerOnlyTenantFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'accountType', 'plan', 'status', 'suspendedReason',
        'tier', 'memberLimit', 'activeMemberCount', 'congregantsAtSignup',
        'billingPhase', 'currentRate', 'paymentStatus', 'pastDueSince', 'lastDunningDay',
        'lastPaymentAt', 'lastPaymentAmount', 'billingHold', 'grandfathered',
        'trialEndsAt', 'evaluationEndsAt', 'fullRateStartsAt',
        'slug', 'ownerEmail', 'signupSource', 'signupDate', 'createdAt',
        'lastLoginAt', 'lastLoginEmail', 'orgId', 'orgRole',
        'churchId', 'archived', 'archivedAt', 'archivedBy', 'lifePhaseYear'
      ]);
    }

    match /tenants/{tenantId} {
      // Tenants are created ONLY by /api/signup via the Admin SDK. Client create
      // stays closed: an open create let any signed-in user write
      // tenants/{theirUid} with accountType "internal" and pass the /api/admin
      // route checks. Covered by tests/rules/tenants.test.ts.
      allow create: if false;
      allow read: if isSignedIn()
                  && (isSuperAdmin() || tenantId == userTenantId());
      // Network roles read every region of their org (the Network page, the
      // switcher). Multi-region leaders read the regions they hold, for the
      // switcher. Covered by tests/rules/churchStructure.test.ts.
      allow read: if isSignedIn()
                  && hasNetworkRole()
                  && callerOrgId() != ''
                  && resource.data.get('orgId', '') == callerOrgId();
      allow read: if isSignedIn()
                  && tenantId in userData().get('tenantAccess', {});
      allow update: if isSignedIn()
                    && (isSuperAdmin()
                        || (tenantId == userTenantId()
                            && canEditChurchProfile()
                            && !touchesServerOnlyTenantFields()));
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // SECURITY: user docs are ONLY ever created server-side via the Admin SDK
      // (/api/signup creates role:"owner", /api/login creates role:"user",
      // /api/invite-member + /api/bulk-invite-members create congregation members).
      // The Admin SDK bypasses these rules, so no client path needs create access.
      // Denying client create closes the privilege-escalation hole where a signed-in
      // user could write their own users doc with role:"super_admin"/"viewer" and an
      // arbitrary tenantId to read another church's data.
      allow create: if false;

      // Read widened to managers so they can see the team list for DRI pickers.
      // Team lists query tenantIds (every region a user holds), so a leader
      // with several regions appears in each. Network owners see their org.
      allow read: if isSignedIn()
                  && (userId == request.auth.uid
                      || isSuperAdmin()
                      || (sameTenant(resource) && canManageMembers()));
      allow read: if isSignedIn()
                  && canManageMembers()
                  && userTenantId() in resource.data.get('tenantIds', []);
      allow read: if isSignedIn()
                  && isNetworkOwner()
                  && callerOrgId() != ''
                  && resource.data.get('orgId', '') == callerOrgId();

      // Fields that decide what a user can reach. Only the server writes them
      // (/api/region-access), apart from the region switch below. Role changes
      // on the team page go through the same route (ADR-010).
      function accessFields() {
        return ['tenantId', 'role', 'roles', 'sectorId', 'familyGroupId',
                'tenantAccess', 'tenantIds', 'orgId', 'networkRole',
                'assignedBranch', 'assignedCellRegion'];
      }
      function changedUserKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Switching the active region: only to a region the user holds (or, for
      // network roles, any region of their org), taking exactly the role and
      // scope recorded for it. Nothing else may change in the same write.
      function isRegionSwitch() {
        let after = request.resource.data;
        let before = resource.data;
        let t = after.get('tenantId', '');
        let acc = before.get('tenantAccess', {});
        return changedUserKeys().hasOnly(['tenantId', 'role', 'roles', 'sectorId', 'familyGroupId'])
            && t is string && t != ''
            && ((t in acc
                 && after.get('role', '') == acc[t].get('role', '')
                 && after.get('roles', []) == acc[t].get('roles', [])
                 && after.get('sectorId', '') == acc[t].get('sectorId', '')
                 && after.get('familyGroupId', '') == acc[t].get('familyGroupId', ''))
                || (!(t in acc)
                    && regionInOrg(t, before.get('orgId', ''))
                    && ((before.get('networkRole', '') == 'network_owner' && after.get('role', '') == 'admin')
                        || (before.get('networkRole', '') == 'network_viewer' && after.get('role', '') == 'viewer'))
                    && after.get('roles', []) == []
                    && after.get('sectorId', '') == ''
                    && after.get('familyGroupId', '') == ''));
      }

      allow update: if isSignedIn()
                    && (
                      isSuperAdmin()
                      // Own profile (name, linked member). Never access, status
                      // or the follow-up flag, which grants guest access.
                      || (userId == request.auth.uid
                          && !changedUserKeys().hasAny(accessFields())
                          && !changedUserKeys().hasAny(['status', 'visitorMinistry']))
                      || (userId == request.auth.uid && isRegionSwitch())
                      // Owner managing their team: the follow-up flag and other
                      // non-access fields only.
                      || (sameTenant(resource)
                          && canManageUsers()
                          && !changedUserKeys().hasAny(accessFields()))
                    );

      // Deleting a user removes every region they hold, so a region owner may
      // only delete someone who holds no other region and no network role.
      allow delete: if isSignedIn()
                    && (isSuperAdmin()
                        || (sameTenant(resource)
                            && canManageUsers()
                            && resource.data.get('tenantIds', []).size() <= 1
                            && resource.data.get('networkRole', '') == ''));
    }

    // ============================================
    // MEMBERS COLLECTION
    // ============================================
    // Member fields the change history records. A browser write that changes
    // any of them must stamp who made it and when, so the onMemberUpdatedAudit
    // function can name them (ADR-010). Keep in step with
    // lib/memberAuditFields.ts and functions/src/memberAuditFormat.ts.
    function auditedMemberFields() {
      return ['status', 'isMember', 'membershipType', 'churchRole', 'role',
              'maritalStatus', 'lifePhases', 'sectorId', 'familyGroupId',
              'branch', 'cellRegion',
              'lifePhasesAdded', 'lifePhasesRemoved', 'gradeAdjust', 'marriageType'];
    }
    // Life phases (ADR-011): the phases are worked out by the server. A
    // browser may set only the inputs an admin controls, within limits.
    function serverOnlyMemberFields() {
      return ['lifePhases', 'lifePhasesAuto', 'lifePhasesYear'];
    }
    function memberInputsValid(d) {
      return (!('gradeAdjust' in d) || (d.gradeAdjust is int && d.gradeAdjust >= -3 && d.gradeAdjust <= 3))
          && (!('marriageType' in d) || d.marriageType in ['', 'civil', 'customary', 'religious'])
          && (!('lifePhasesAdded' in d) || (d.lifePhasesAdded is list && d.lifePhasesAdded.size() <= 25))
          && (!('lifePhasesRemoved' in d) || (d.lifePhasesRemoved is list && d.lifePhasesRemoved.size() <= 25));
    }
    function memberUpdateFieldsOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyMemberFields())
          && memberInputsValid(request.resource.data);
    }
    function stampedIfAudited() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(auditedMemberFields())
          || (request.resource.data.get('updatedBy', '') == request.auth.uid
              && request.resource.data.get('updatedAt', null) == request.time);
    }

    match /members/{memberId} {
      // Admin access
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadMembers();
      // Congregation member can read their own doc. They can NOT write it:
      // changes go through member_change_requests and admin approval
      // (ADR-007). The old direct self-update let a member change their own
      // status, branch or church role. Covered by tests/rules/memberSelfService.test.ts.
      allow read: if isSignedIn() && isOwnMemberDoc(resource);
      // Network roles read every region of their org. Sector and family group
      // leaders read only their own people; list queries must filter on the
      // same field (ADR-010).
      allow read: if isSignedIn() && networkCanRead(resource.data.tenantId);
      allow read: if isSignedIn()
                  && sameTenant(resource)
                  && leaderSectorId() != ''
                  && resource.data.sectorId == leaderSectorId();
      allow read: if isSignedIn()
                  && sameTenant(resource)
                  && leaderFamilyGroupId() != ''
                  && resource.data.familyGroupId == leaderFamilyGroupId();
      allow create: if isSignedIn()
                    && ((tenantAllowedWrite(request.resource.data) && canManageMembers())
                        || networkCanWrite(request.resource.data.tenantId))
                    && !request.resource.data.keys().hasAny(serverOnlyMemberFields())
                    && memberInputsValid(request.resource.data)
                    && withinMemberLimit(request.resource.data);
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageMembers()
                    && stampedIfAudited()
                    && memberUpdateFieldsOk();
      allow update: if isSignedIn()
                    && networkCanWrite(resource.data.tenantId)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && stampedIfAudited()
                    && memberUpdateFieldsOk();
      // Follow-up team: may touch the care follow-up stamp ONLY, so completing a
      // care workflow moves the member off the Care Tier Alerts list. No other
      // member field can be changed through this rule.
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canDoFollowUp()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['careFollowUp']);
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageMembers();
    }

    // ============================================
    // ATTENDANCE COLLECTION
    // ============================================
    match /attendance/{recordId} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadAttendance();
      // Sector and family group leaders: records stamped with their own sector
      // or group only, for people who really are in it. Records carry absence
      // reasons, so region-wide access is not given (ADR-010).
      function leaderMayMark(data) {
        return data.tenantId == userTenantId()
            && exists(/databases/$(database)/documents/members/$(data.personId))
            && ((leaderSectorId() != ''
                 && data.sectorId == leaderSectorId()
                 && get(/databases/$(database)/documents/members/$(data.personId)).data.get('sectorId', '') == leaderSectorId())
                || (leaderFamilyGroupId() != ''
                    && data.familyGroupId == leaderFamilyGroupId()
                    && get(/databases/$(database)/documents/members/$(data.personId)).data.get('familyGroupId', '') == leaderFamilyGroupId()));
      }
      allow read: if isSignedIn()
                  && sameTenant(resource)
                  && ((leaderSectorId() != '' && resource.data.sectorId == leaderSectorId())
                      || (leaderFamilyGroupId() != '' && resource.data.familyGroupId == leaderFamilyGroupId()));
      allow create: if isSignedIn() && leaderMayMark(request.resource.data);
      allow update: if isSignedIn()
                    && leaderMayMark(resource.data)
                    && leaderMayMark(request.resource.data);
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageAttendance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageAttendance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageAttendance();
    }

    // ============================================
    // FINANCE: contributions, expenses, accounts
    // ============================================
    match /contributions/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }
    match /expenses/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }
    match /accounts/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // COMMUNICATIONS COLLECTION
    // ============================================
    match /communications/{docId} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canManageCommunications();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageCommunications();
      // Cloud Function updates status via Admin SDK - no client update needed.
      allow update: if false;
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageCommunications();
    }

    // ============================================
    // HOUSEHOLDS COLLECTION
    // ============================================
    match /households/{id} {
      // Any user with a linked member profile can read their own household
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.tenantId == userTenantId();
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadMembers();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageMembers();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageMembers();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageMembers();
    }

    // ============================================
    // VISITORS COLLECTION
    // ============================================
    match /visitors/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && (canReadMembers() || canDoFollowUp());
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (canManageMembers() || canDoFollowUp());
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (canManageMembers() || canDoFollowUp());
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageMembers();
    }

    // ============================================
    // TRANSACTIONS COLLECTION
    // ============================================
    match /transactions/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      // Any user with a linked member profile can read their own transactions.
      // Works for congregation_member AND promoted/team users who have linked their profile.
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.memberId == userData().memberId;
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // STAGED TRANSACTIONS (imported statement rows awaiting review)
    // Same tenant isolation and finance permissions as transactions.
    // No member self-read: these are provisional and only finance staff touch them.
    // ============================================
    match /staged_transactions/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // SYSTEM ADMINS COLLECTION
    // ============================================
    match /system_admins/{id} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // DEMO REQUESTS (public marketing form submissions)
    // ============================================
    match /demo_requests/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // SUPPORT TICKETS
    // Public: anyone can submit (marketing form, unauthenticated)
    // Tenant: owners/admins can read their own church's tickets
    // Super admin: full access
    // ============================================
    match /support_tickets/{id} {
      // Anyone can submit - public form and authenticated dashboard users
      allow create: if true;
      // Super admin: full access
      allow read, update, delete: if isSignedIn() && isSuperAdmin();
      // Tenant owner/admin: read only their own church's tickets
      allow read: if isSignedIn()
                  && resource.data.tenantId == userTenantId()
                  && (hasRole('owner') || hasRole('admin'));
    }

    // ============================================
    // ONLINE GIVING RECORDS
    // Public: anyone can create (unauthenticated giving form)
    // Finance roles: read their own tenant's records
    // Super admin: full access
    // ============================================
    match /giving_records/{id} {
      // Public giving form writes without auth
      allow create: if true;
      // Super admin full access
      allow read, update, delete: if isSignedIn() && isSuperAdmin();
      // Finance roles can read their own church records
      allow read: if isSignedIn()
                  && resource.data.tenantId == userTenantId()
                  && canReadFinance();
      // Finance roles can update (e.g. marking EFT as confirmed)
      allow update: if isSignedIn()
                    && resource.data.tenantId == userTenantId()
                    && canManageFinance();
    }

    // ============================================
    // FINANCE CATEGORIES (configurable per tenant)
    // Finance roles: read
    // Owner/Admin: full CRUD
    // Public giving API: read (via admin SDK, bypasses rules)
    // ============================================
    match /finance_categories/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (resource.data.tenantId == userTenantId() && canReadFinance()));
      allow create: if isSignedIn()
                    && request.resource.data.tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || isSuperAdmin());
      allow update: if isSignedIn()
                    && resource.data.tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || isSuperAdmin());
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (resource.data.tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // CARE TIER FOLLOW-UP NOTES
    // ============================================
    match /careTierNotes/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadAttendance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageAttendance();
      allow update: if false;
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageAttendance();
    }

    // ============================================
    // FORMS (church-built custom forms)
    // ============================================
    match /forms/{id} {
      // Public: anyone can read any form (active check is enforced in app code,
      // so inactive forms show "Form is closed" instead of "not found")
      allow read: if true;
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // FORM SUBMISSIONS (public form responses)
    // ============================================
    match /form_submissions/{id} {
      // Anyone can submit (public form - no auth required)
      allow create: if true;
      // Super admin or tenant staff can read form submissions
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (resource.data.tenantId == userTenantId()
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
      // No updates or deletes on submissions (immutable audit trail)
      allow update, delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // WORKFLOWS (templates)
    // ============================================
    match /workflows/{id} {
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || canDoFollowUp())));
      allow create: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow update: if isSignedIn() && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }
    match /workflow_steps/{id} {
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
      // create/update: check new data; delete: check existing resource (request.resource.data is null on delete)
      allow create, update: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                             && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                             && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }
    match /workflow_instances/{id} {
      // Managers see everything; the assignee can read their own follow-ups.
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                  || resource.data.assignedToUid == request.auth.uid)));
      allow create: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || canDoFollowUp());
      allow update: if isSignedIn() && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                    || (canDoFollowUp() && resource.data.assignedToUid == request.auth.uid));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }
    match /workflow_instance_steps/{id} {
      // Managers see everything; the assignee can read + tick off their own steps.
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                  || resource.data.assignedToUid == request.auth.uid)));
      allow create: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || canDoFollowUp());
      allow update: if isSignedIn() && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                    || resource.data.assignedToUid == request.auth.uid);
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // NOTES (timestamped audit notes under a parent doc)
    // Written by NotesPanel under members/*, visitors/*, and workflow_instances/*.
    // Each note stores its own tenantId so these rules keep them isolated per
    // church without reading the parent. Notes are an immutable trail: create
    // only, never edited or deleted. Any staff member who can see members or work
    // follow-ups can read them, so admins can always go back and see notes even
    // after a workflow is closed. (Firestore requires an explicit rule per parent;
    // a recursive wildcard can't be followed by /notes/{id}.)
    // ============================================
    function canReadNotes() {
      return isSuperAdmin()
          || (resource.data.tenantId == userTenantId() && (canReadMembers() || canDoFollowUp()));
    }
    function canCreateNote() {
      return isSuperAdmin()
          || (request.resource.data.tenantId == userTenantId() && (canManageMembers() || canDoFollowUp()));
    }
    match /members/{parentId}/notes/{noteId} {
      allow read: if isSignedIn() && canReadNotes();
      allow create: if isSignedIn() && canCreateNote();
      allow update, delete: if false;
    }
    match /visitors/{parentId}/notes/{noteId} {
      allow read: if isSignedIn() && canReadNotes();
      allow create: if isSignedIn() && canCreateNote();
      allow update, delete: if false;
    }
    match /workflow_instances/{parentId}/notes/{noteId} {
      allow read: if isSignedIn() && canReadNotes();
      allow create: if isSignedIn() && canCreateNote();
      allow update, delete: if false;
    }

    // ============================================
    // EVENTS
    // ============================================
    match /events/{id} {
      // Public can read active events so the RSVP link page can render event details
      allow read: if resource.data.active == true;
      // Any user with a linked member profile can read events for their church
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.tenantId == userTenantId();
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('viewer'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // EVENT RSVPS
    // Merged: public RSVP link + tenant staff + linked congregation members.
    // ============================================
    match /event_rsvps/{id} {
      // Public RSVP link: anyone can submit an RSVP without being logged in
      allow create: if true;
      // Read: super admin, tenant staff, or a linked member in the same tenant
      allow read: if isSignedIn()
                  && (
                    isSuperAdmin()
                    || (tenantAllowed(resource)
                        && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('viewer')))
                    || (hasLinkedMemberProfile() && resource.data.tenantId == userTenantId())
                  );
      // Update: tenant staff, or a linked member editing their own RSVP
      allow update: if isSignedIn()
                    && (
                      (tenantAllowed(resource)
                        && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')))
                      || (hasLinkedMemberProfile()
                          && resource.data.tenantId == userTenantId()
                          && resource.data.uid == request.auth.uid)
                    );
      // Delete: super admin or tenant staff
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }

    // ============================================
    // GROUPS
    // ============================================
    match /groups/{id} {
      // Any user with a linked member profile can read groups in their church
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.tenantId == userTenantId();
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader') || hasRole('viewer'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // GROUP MEMBERS
    // Merged: tenant staff + linked congregation members (read own memberships).
    // ============================================
    match /group_members/{id} {
      allow read: if isSignedIn()
                  && (
                    isSuperAdmin()
                    || (tenantAllowed(resource)
                        && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader')))
                    || (hasLinkedMemberProfile() && resource.data.tenantId == userTenantId())
                  );
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }

    // ============================================
    // GROUP ATTENDANCE SESSIONS
    // ============================================
    match /group_attendance/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // GROUP ATTENDANCE RECORDS (per-member per-session)
    // ============================================
    match /group_attendance_records/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // WORSHIP: SONG LIBRARY (subcollection of tenant)
    // ============================================
    match /tenants/{tenantId}/songs/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create, update: if isSignedIn()
                             && tenantId == userTenantId()
                             && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                             && callerIsPaid();
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin'));
    }

    // ============================================
    // WORSHIP: SETLISTS (subcollection of tenant)
    // Merged: any tenant user can read; owner/admin/member_manager/super_admin write.
    // ============================================
    match /tenants/{tenantId}/setlists/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create, update: if isSignedIn()
                             && tenantId == userTenantId()
                             && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || isSuperAdmin())
                             && callerIsPaid();
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || isSuperAdmin());
    }

    // ============================================
    // VOLUNTEER ROLES (subcollection of tenant)
    // ============================================
    match /tenants/{tenantId}/volunteerRoles/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      // Delete stays open so a downgraded church can still remove old roles.
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow update: if false;
    }

    // ============================================
    // VOLUNTEER ASSIGNMENTS (subcollection of tenant)
    // ============================================
    match /tenants/{tenantId}/volunteerAssignments/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow update: if false;
    }

    // ============================================
    // DAILY SUMMARY SETTINGS (paid feature)
    // Doc id is the tenantId. The Cloud Function that sends the summary reads
    // this via the Admin SDK (bypasses these rules). Owner/admin of the tenant
    // may read; writing (turning it on / configuring) requires the paid plan.
    // ============================================
    match /summarySettings/{tenantId} {
      allow read: if isSignedIn()
                  && (isSuperAdmin()
                      || (tenantId == userTenantId() && (hasRole('owner') || hasRole('admin'))));
      allow create, update: if isSignedIn()
                            && tenantId == userTenantId()
                            && (hasRole('owner') || hasRole('admin'))
                            && callerIsPaid();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // TENANT SETTINGS DOCUMENTS
    // Only the listed documents are reachable from the browser. formConfig is
    // the Church Settings form layout (it had no rule before, so every client
    // read and write of it was denied). Other settings documents, such as
    // whatsapp, stay server-only.
    // ============================================
    match /tenants/{tenantId}/settings/{docId} {
      allow read: if isSignedIn()
                  && docId in ['formConfig', 'memberSelfService']
                  && (isSuperAdmin() || tenantId == userTenantId());
      allow write: if isSignedIn()
                   && docId in ['formConfig', 'memberSelfService']
                   && (isSuperAdmin() || (tenantId == userTenantId() && canEditChurchProfile()))
                   && (docId != 'memberSelfService'
                       || request.resource.data.get('editableFields', []).hasOnly(['phone', 'email', 'address']));
    }

    // ============================================
    // MEMBER SELF-SERVICE (ADR-007) — start
    // Members request changes to a church-chosen subset of their own contact
    // details; an admin approves or rejects. Requests are never deleted, so
    // they are the audit trail. Keep the field list in step with
    // lib/memberSelfService.ts. Tests: tests/rules/memberSelfService.test.ts.
    // ============================================
    function selfServiceFields(tid) {
      let settings = /databases/$(database)/documents/tenants/$(tid)/settings/memberSelfService;
      return exists(settings)
          ? get(settings).data.get('editableFields', [])
          : ['phone', 'email', 'address'];
    }
    function callerOwnsMember(memberId, tid) {
      let m = get(/databases/$(database)/documents/members/$(memberId)).data;
      return m.get('authUid', '') == request.auth.uid && m.tenantId == tid;
    }
    match /member_change_requests/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ['tenantId', 'memberId', 'requestedByUid', 'memberName', 'status', 'changes', 'createdAt'])
                    && request.resource.data.requestedByUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.changes is map
                    && request.resource.data.changes.size() > 0
                    && request.resource.data.changes.keys().hasOnly(['phone', 'email', 'address'])
                    && request.resource.data.changes.keys().hasOnly(selfServiceFields(request.resource.data.tenantId))
                    && callerOwnsMember(request.resource.data.memberId, request.resource.data.tenantId);
      allow read: if isSignedIn()
                  && (resource.data.requestedByUid == request.auth.uid
                      || (tenantAllowed(resource) && canManageMembers()));
      // Review only: pending to approved or rejected, once, recording the
      // real reviewer. The requested changes themselves can never be edited.
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageMembers()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.reviewedByUid == request.auth.uid
                    && request.resource.data.reviewedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedByUid', 'reviewedByName', 'reviewedAt', 'rejectReason']);
      allow delete: if false;
    }
    // MEMBER SELF-SERVICE — end

    // ============================================
    // MEMBER REQUESTS (public self-join form submissions)
    // Anyone can submit without auth. Admins review in dashboard.
    // ============================================
    match /memberRequests/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn()
                                  && (isSuperAdmin()
                                      || (request.auth != null
                                          && resource.data.tenantId == userTenantId()
                                          && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }

    // ============================================
    // SELF-SERVICE SIGNUPS
    // Written by API route (admin SDK) on registration.
    // Super admin: full access for management dashboard.
    // ============================================
    match /signups/{id} {
      allow read, write: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // ANNOUNCEMENTS
    // ============================================
    match /announcements/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin()
                      || (resource.data.tenantId == userTenantId()
                          && (canManageCommunications() || hasLinkedMemberProfile())));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageCommunications();
      allow update, delete: if isSignedIn()
                            && tenantAllowed(resource)
                            && canManageCommunications();
    }

    // ============================================
    // EVENT CHECK-INS
    // Congregation members can create their own check-ins and read them.
    // Admins/managers can read all check-ins for their church.
    // ============================================
    match /event_checkins/{id} {
      // Admin access
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('viewer'))));
      // Any user with a linked member profile can read their own check-ins.
      // Do NOT add tenantId check here - it's not in the query's WHERE clause.
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.uid == request.auth.uid;
      // Any authenticated tenant user can create a check-in for themselves.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.tenantId == userTenantId();
      // Admins can also create check-ins on behalf of members (manual override)
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // PUSH SUBSCRIPTIONS (per uid)
    // ============================================
    match /push_subscriptions/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ============================================
    // STAFF MEMBERS (church workers for payslip generation)
    // ============================================
    match /staff_members/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // PAYSLIP RECORDS (generated payslip history)
    // ============================================
    match /payslip_records/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // INVOICE RECORDS (generated invoice history + status tracking)
    // ============================================
    match /invoice_records/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // PASTORAL CARE LOGS (sensitive - owner and admin only)
    // ============================================
    match /care_logs/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
    }

    // ============================================
    // EVERYTHING ELSE: deny by default
    // ============================================
  }
}
